<div class="container py-5">
  <div class="row justify-content-center">
    <div class="col-12 col-md-8">

      <div class="card shadow-sm">
        <div class="card-body p-4">

          <h2 class="fw-bold mb-4">
            プロフィール編集
          </h2>

          <%= form_with model: @user,
                        url: public_user_path,
                        method: :patch,
                        local: true do |f| %>

            <div class="mb-3">
              <%= f.label :name, "氏名", class: "form-label" %>
              <%= f.text_field :name, class: "form-control" %>
            </div>

            <div class="mb-3">
              <%= f.label :introduction, "自己紹介", class: "form-label" %>
              <%= f.text_area :introduction,
                              rows: 4,
                              class: "form-control" %>
            </div>

            <div class="mb-3">
              <%= f.label :acting_experience, "演技経験", class: "form-label" %>
              <%= f.text_area :acting_experience,
                              rows: 3,
                              class: "form-control" %>
            </div>

            <div class="mb-3">
              <%= f.label :singing_experience, "歌唱経験", class: "form-label" %>
              <%= f.text_area :singing_experience,
                              rows: 3,
                              class: "form-control" %>
            </div>

            <div class="mb-3">
              <%= f.label :dance_experience, "ダンス経験", class: "form-label" %>
              <%= f.text_area :dance_experience,
                              rows: 3,
                              class: "form-control" %>
            </div>

            <div class="mb-4">
              <%= f.label :preferred_area, "希望地域", class: "form-label" %>
              <%= f.text_field :preferred_area,
                               class: "form-control",
                               placeholder: "例：東京都、大阪府" %>
            </div>

            <div class="d-flex gap-3">
              <%= f.submit "変更を保存",
                           class: "btn btn-primary" %>

              <%= link_to "戻る",
                          public_user_path,
                          class: "btn btn-outline-secondary" %>

              <%= link_to "退会する",
                          unsubscribe_public_user_path,
                          class: "btn btn-outline-danger" %>
            </div>

          <% end %>

        </div>
      </div>

    </div>
  </div>
</div>