<div class="container py-4 py-md-5">

  <div class="row justify-content-center">
    <div class="col-12 col-xl-10">

      <div class="mb-4">
        <h2 class="fw-bold mb-1">
          プロフィール編集
        </h2>

        <p class="text-muted mb-0">
          劇団にあなたの経験や希望を伝えるプロフィールを編集できます。
        </p>
      </div>

      <div class="card shadow-sm border-0">
        <div class="card-body p-4 p-md-5">

          <%= form_with model: @user,
                        url: public_user_path,
                        method: :patch,
                        local: true do |f| %>

            <div class="row g-5">

              <!-- 左側：プロフィールイメージ -->
              <div class="col-12 col-md-4">

                <div class="text-center">

                  <div class="rounded-circle bg-light border
                              d-flex align-items-center justify-content-center
                              mx-auto mb-3"
                       style="width: 140px; height: 140px;">

                    <span class="text-muted">
                      プロフィール画像
                    </span>

                  </div>

                  <h5 class="fw-bold mb-1">
                    <%= @user.name.presence || "ユーザー" %>
                  </h5>

                  <p class="text-muted small mb-0">
                    <%= @user.email %>
                  </p>

                </div>

              </div>


              <!-- 右側：プロフィール編集フォーム -->
              <div class="col-12 col-md-8">

                <!-- 氏名 -->
                <div class="mb-4">
                  <%= f.label :name,
                              "氏名",
                              class: "form-label fw-bold" %>

                  <%= f.text_field :name,
                                   class: "form-control",
                                   placeholder: "例：山田 花子" %>
                </div>


                <!-- 自己紹介 -->
                <div class="mb-4">
                  <%= f.label :introduction,
                              "自己紹介",
                              class: "form-label fw-bold" %>

                  <%= f.text_area :introduction,
                                  rows: 4,
                                  class: "form-control",
                                  placeholder: "これまでの活動や自己PRを入力してください" %>
                </div>


                <!-- 演技経験 -->
                <div class="mb-4">
                  <%= f.label :acting_experience,
                              "演技経験",
                              class: "form-label fw-bold" %>

                  <%= f.text_area :acting_experience,
                                  rows: 3,
                                  class: "form-control",
                                  placeholder: "例：舞台経験3年" %>
                </div>


                <!-- 歌唱経験 -->
                <div class="mb-4">
                  <%= f.label :singing_experience,
                              "歌唱経験",
                              class: "form-label fw-bold" %>

                  <%= f.text_area :singing_experience,
                                  rows: 3,
                                  class: "form-control",
                                  placeholder: "例：ボーカルレッスン2年" %>
                </div>


                <!-- ダンス経験 -->
                <div class="mb-4">
                  <%= f.label :dance_experience,
                              "ダンス経験",
                              class: "form-label fw-bold" %>

                  <%= f.text_area :dance_experience,
                                  rows: 3,
                                  class: "form-control",
                                  placeholder: "例：ジャズダンス1年" %>
                </div>


                <!-- 希望地域 -->
                <div class="mb-4">
                  <%= f.label :preferred_area,
                              "希望地域",
                              class: "form-label fw-bold" %>

                  <%= f.select :preferred_area,
                               [
                                 "東京都",
                                 "神奈川県",
                                 "千葉県",
                                 "埼玉県",
                                 "大阪府",
                                 "京都府",
                                 "兵庫県",
                                 "新潟県"
                               ],
                               {
                                 include_blank: "希望地域を選択"
                               },
                               class: "form-select" %>
                </div>


                <!-- ボタン -->
                <div class="d-grid d-md-flex gap-2">

                  <%= f.submit "変更を保存",
                               class: "btn btn-primary px-4" %>

                  <%= link_to "マイページに戻る",
                              public_user_path,
                              class: "btn btn-outline-secondary px-4" %>

                </div>

              </div>

            </div>

          <% end %>

        </div>
      </div>


      <!-- 退会 -->
      <div class="text-end mt-3">

        <%= link_to "退会手続きはこちら",
                    unsubscribe_public_user_path,
                    class: "text-danger text-decoration-none small" %>

      </div>

    </div>
  </div>

</div>