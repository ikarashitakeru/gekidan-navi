<div class="container py-5">
  <div class="row justify-content-center">
    <div class="col-12 col-md-8">

      <div class="card shadow-sm">
        <div class="card-body p-4">

          <h2 class="fw-bold mb-4">
            マイページ
          </h2>

          <div class="mb-3">
            <strong>氏名</strong>
            <p class="mb-0"><%= @user.name %></p>
          </div>

          <div class="mb-3">
            <strong>メールアドレス</strong>
            <p class="mb-0"><%= @user.email %></p>
          </div>

          <div class="mb-3">
            <strong>自己紹介</strong>
            <p class="mb-0">
              <%= @user.introduction.presence || "未登録" %>
            </p>
          </div>

          <div class="mb-3">
            <strong>演技経験</strong>
            <p class="mb-0">
              <%= @user.acting_experience.presence || "未登録" %>
            </p>
          </div>

          <div class="mb-3">
            <strong>歌唱経験</strong>
            <p class="mb-0">
              <%= @user.singing_experience.presence || "未登録" %>
            </p>
          </div>

          <div class="mb-3">
            <strong>ダンス経験</strong>
            <p class="mb-0">
              <%= @user.dance_experience.presence || "未登録" %>
            </p>
          </div>

          <div class="mb-4">
            <strong>希望地域</strong>
            <p class="mb-0">
              <%= @user.preferred_area.presence || "未登録" %>
            </p>
          </div>

          <%= link_to "プロフィールを編集",
                      edit_public_user_path,
                      class: "btn btn-primary" %>

        </div>
      </div>

    </div>
  </div>
</div>