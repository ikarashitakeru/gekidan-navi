<div class="container py-4 py-md-5">

  <h2 class="fw-bold mb-4">募集を探す</h2>

  <% if @recruitments.any? %>

    <div class="row g-3">

      <% @recruitments.each do |recruitment| %>
        <div class="col-12">

          <div class="card shadow-sm h-100">
            <div class="card-body p-3 p-md-4">

              <h4 class="fw-bold mb-3">
                <%= recruitment.title %>
              </h4>

              <p class="mb-1">
                <strong>劇団名：</strong>
                <%= recruitment.theater.name %>
              </p>

              <p class="mb-1">
                <strong>活動地域：</strong>
                <%= recruitment.activity_area %>
              </p>

              <p class="mb-1">
                <strong>募集人数：</strong>
                <%= recruitment.capacity %>人
              </p>

              <p class="mb-4">
                <strong>応募締切：</strong>
                <%= recruitment.deadline %>
              </p>

              <div class="d-grid d-md-block">
                <%= link_to "募集詳細を見る",
                            public_recruitment_path(recruitment),
                            class: "btn btn-outline-primary" %>
              </div>

            </div>
          </div>

        </div>
      <% end %>

    </div>

  <% else %>

    <div class="alert alert-light border">
      現在募集中の募集はありません。
    </div>

  <% end %>

</div>