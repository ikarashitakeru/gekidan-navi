<div class="container py-4 py-md-5">
  <div class="row justify-content-center">
    <div class="col-12 col-lg-8">

      <div class="card shadow-sm">
        <div class="card-body p-3 p-md-4">

          <h2 class="fw-bold mb-4">
            <%= @recruitment.title %>
          </h2>

          <div class="mb-3">
            <strong>劇団名</strong>
            <p class="mb-0">
              <%= @recruitment.theater.name %>
            </p>
          </div>

          <div class="mb-3">
            <strong>募集内容</strong>
            <%= simple_format(@recruitment.description) %>
          </div>

          <div class="mb-3">
            <strong>募集人数</strong>
            <p class="mb-0">
              <%= @recruitment.capacity %>名
            </p>
          </div>

          <div class="mb-3">
            <strong>応募締切</strong>
            <p class="mb-0">
              <%= @recruitment.deadline %>
            </p>
          </div>

          <div class="mb-3">
            <strong>活動地域</strong>
            <p class="mb-0">
              <%= @recruitment.activity_area %>
            </p>
          </div>

          <div class="mb-4">
            <strong>募集状態</strong>
            <p class="mb-0">
              <%= @recruitment.open? ? "募集中" : "募集終了" %>
            </p>
          </div>

          <div class="d-grid d-md-flex gap-2 gap-md-3">

            <% if user_signed_in? && @recruitment.open? %>

              <% if current_user.applications.exists?(recruitment: @recruitment) %>

                <span class="btn btn-secondary disabled">
                  応募済み
                </span>

              <% else %>

                <%= link_to "応募する",
                            new_public_recruitment_application_path(@recruitment),
                            class: "btn btn-primary" %>

              <% end %>

            <% end %>

            <%= link_to "募集一覧へ戻る",
                        public_recruitments_path,
                        class: "btn btn-outline-secondary" %>

          </div>

        </div>
      </div>

    </div>
  </div>
</div>