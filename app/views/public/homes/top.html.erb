<div class="top-page">

  <!-- ==============================
       ヒーローエリア
  ============================== -->
  <section class="hero-section">
    <div class="container py-4 py-md-5">

      <div
        class="hero-visual position-relative overflow-hidden"
        style="
          background-image:
            linear-gradient(
              90deg,
              rgba(35, 20, 20, 0.92) 0%,
              rgba(45, 20, 25, 0.76) 48%,
              rgba(0, 0, 0, 0.18) 100%
            ),
            url('<%= asset_path("AIAI_25312_a060-SL_TP_V.jpg") %>');
        "
      >

        <div class="row">
          <div class="col-12 col-lg-8">

            <div class="hero-content">

              <p class="hero-subtitle">
                THEATER × PERFORMER
              </p>

              <p class="hero-service-name">
                劇団・出演者募集マッチングサービス
              </p>

              <h1 class="hero-title">
                あなたの情熱が、<br>
                舞台に立つきっかけになる。
              </h1>

              <p class="hero-description">
                劇団と出演希望者をつなぐ、劇団員募集サービスです。<br>
                あなたに合った新しい舞台を見つけてみませんか？
              </p>

              <!-- 検索フォーム -->
              <div class="hero-search">

                <%= form_with url: public_recruitments_path,
                              method: :get,
                              local: true do |f| %>

                  <div class="row g-2">

                    <div class="col-12 col-md-5">
                      <%= f.text_field :keyword,
                                       class: "form-control form-control-lg",
                                       placeholder: "キーワード・劇団名など" %>
                    </div>

                    <div class="col-12 col-md-4">

                      <%= f.select :area,
                                   [
                                     "北海道",
                                     "青森県",
                                     "岩手県",
                                     "宮城県",
                                     "秋田県",
                                     "山形県",
                                     "福島県",
                                     "茨城県",
                                     "栃木県",
                                     "群馬県",
                                     "埼玉県",
                                     "千葉県",
                                     "東京都",
                                     "神奈川県",
                                     "新潟県",
                                     "富山県",
                                     "石川県",
                                     "福井県",
                                     "山梨県",
                                     "長野県",
                                     "岐阜県",
                                     "静岡県",
                                     "愛知県",
                                     "三重県",
                                     "滋賀県",
                                     "京都府",
                                     "大阪府",
                                     "兵庫県",
                                     "奈良県",
                                     "和歌山県",
                                     "鳥取県",
                                     "島根県",
                                     "岡山県",
                                     "広島県",
                                     "山口県",
                                     "徳島県",
                                     "香川県",
                                     "愛媛県",
                                     "高知県",
                                     "福岡県",
                                     "佐賀県",
                                     "長崎県",
                                     "熊本県",
                                     "大分県",
                                     "宮崎県",
                                     "鹿児島県",
                                     "沖縄県"
                                   ],
                                   { include_blank: "活動地域を選択" },
                                   class: "form-select form-select-lg" %>

                    </div>

                    <div class="col-12 col-md-3 d-grid">

                      <%= f.submit "募集を検索",
                                   class: "btn btn-theater btn-lg" %>

                    </div>

                  </div>

                <% end %>

              </div>

            </div>

          </div>
        </div>

      </div>

    </div>
  </section>


  <!-- ==============================
       劇団ナビでできること
  ============================== -->
  <section class="service-section">

    <div class="container py-5">

      <div class="text-center mb-5">

        <p class="section-label">
          SERVICE
        </p>

        <h2 class="section-title">
          劇団ナビでできること
        </h2>

        <p class="section-description">
          舞台に立ちたい人と、新しい仲間を探している劇団をつなぎます。
        </p>

      </div>


      <div class="row g-4">

        <!-- 募集を探す -->
        <div class="col-12 col-md-4">

          <div class="service-card">

            <div class="service-number">
              01
            </div>

            <h3>
              募集を探す
            </h3>

            <p>
              地域やキーワードから、
              あなたに合った劇団や出演募集を探すことができます。
            </p>

          </div>

        </div>


        <!-- 応募する -->
        <div class="col-12 col-md-4">

          <div class="service-card">

            <div class="service-number">
              02
            </div>

            <h3>
              気になる募集に応募
            </h3>

            <p>
              興味を持った募集を確認して、
              劇団のオーディションや出演募集に応募できます。
            </p>

          </div>

        </div>


        <!-- 劇団とつながる -->
        <div class="col-12 col-md-4">

          <div class="service-card">

            <div class="service-number">
              03
            </div>

            <h3>
              劇団とつながる
            </h3>

            <p>
              応募やスカウトを通して、
              新しい劇団や舞台との出会いにつなげることができます。
            </p>

          </div>

        </div>

      </div>

    </div>

  </section>


  <!-- ==============================
       新着募集
  ============================== -->
  <section class="recruitment-section">

    <div class="container py-5">

      <div class="d-flex justify-content-between align-items-end mb-4">

        <div>

          <p class="section-label mb-1">
            NEW AUDITIONS
          </p>

          <h2 class="section-title mb-0">
            新着の募集
          </h2>

        </div>


        <%= link_to "募集をすべて見る →",
                    public_recruitments_path,
                    class: "section-link" %>

      </div>


      <% if Recruitment.exists? %>

        <div class="row g-4">

          <% Recruitment.includes(:theater)
                        .order(created_at: :desc)
                        .limit(3)
                        .each do |recruitment| %>

            <div class="col-12 col-md-4">

              <div class="recruitment-card">

                <!-- 募集画像 -->
                <% if recruitment.image.attached? %>

                  <%= image_tag recruitment.image,
                                class: "recruitment-image" %>

                <% else %>

                  <div class="recruitment-image-placeholder">

                    <span>
                      募集イメージ未登録
                    </span>

                  </div>

                <% end %>


                <div class="recruitment-card-body">

                  <p class="recruitment-area">
                    <%= recruitment.activity_area %>
                  </p>

                  <h3 class="recruitment-title">
                    <%= recruitment.title %>
                  </h3>

                  <p class="recruitment-theater">
                    <%= recruitment.theater.name %>
                  </p>


                  <%= link_to "募集詳細を見る",
                              public_recruitment_path(recruitment),
                              class: "btn btn-outline-theater" %>

                </div>

              </div>

            </div>

          <% end %>

        </div>


      <% else %>

        <div class="empty-recruitment">

          現在、新着募集はありません。

        </div>

      <% end %>

    </div>

  </section>


  <!-- ==============================
       CTA
  ============================== -->
  <section class="top-cta">

    <div class="container">

      <div class="top-cta-inner">

        <p class="cta-label">
          FIND YOUR STAGE
        </p>

        <h2>
          あなたに合った舞台を<br class="d-md-none">
          探してみませんか？
        </h2>

        <p>
          新しい劇団、新しい仲間、新しい舞台。<br>
          次の一歩につながる募集を探してみましょう。
        </p>


        <%= link_to "募集を探す",
                    public_recruitments_path,
                    class: "btn cta-button" %>

      </div>

    </div>

  </section>

</div>