<div class="container py-4 py-md-5">

  <!-- ヒーローエリア -->
  <section class="mb-5">
    <div
      class="position-relative overflow-hidden rounded shadow-sm"
      style="
        min-height: 390px;
        background-image:
          linear-gradient(
            90deg,
            rgba(0, 0, 0, 0.88) 0%,
            rgba(0, 0, 0, 0.72) 45%,
            rgba(0, 0, 0, 0.20) 100%
          ),
          url('<%= asset_path("AIAI_25312_a060-SL_TP_V.jpg") %>');
        background-size: cover;
        background-position: center;
      "
    >

      <div class="row min-vh-0">
        <div class="col-12 col-lg-8">

          <div class="p-4 p-md-5 text-white d-flex flex-column justify-content-center"
               style="min-height: 390px;">

            <p class="mb-2 text-white-50">
              劇団・出演者募集マッチングサービス
            </p>

            <h1 class="display-5 fw-bold mb-3">
              あなたの情熱が、<br>
              舞台に立つきっかけになる。
            </h1>

            <p class="mb-4">
              劇団と出演希望者をつなぐ、劇団員募集サービスです。
            </p>

            <%= form_with url: public_recruitments_path,
                          method: :get,
                          local: true do |f| %>

              <div class="row g-2">

                <!-- キーワード検索 -->
                <div class="col-12 col-md-5">
                  <%= f.text_field :keyword,
                                   class: "form-control form-control-lg",
                                   placeholder: "キーワード・劇団名など" %>
                </div>

                <!-- 活動地域 -->
                <div class="col-12 col-md-4">
                  <%= f.select :area,
                               [
                                 "北海道",
                                 "青森県",
                                 "岩手県",
                                 "宮城県",
                                 "秋田県",
                                 "山形県",
                                 "福島県",
                                 "茨城県",
                                 "栃木県",
                                 "群馬県",
                                 "埼玉県",
                                 "千葉県",
                                 "東京都",
                                 "神奈川県",
                                 "新潟県",
                                 "富山県",
                                 "石川県",
                                 "福井県",
                                 "山梨県",
                                 "長野県",
                                 "岐阜県",
                                 "静岡県",
                                 "愛知県",
                                 "三重県",
                                 "滋賀県",
                                 "京都府",
                                 "大阪府",
                                 "兵庫県",
                                 "奈良県",
                                 "和歌山県",
                                 "鳥取県",
                                 "島根県",
                                 "岡山県",
                                 "広島県",
                                 "山口県",
                                 "徳島県",
                                 "香川県",
                                 "愛媛県",
                                 "高知県",
                                 "福岡県",
                                 "佐賀県",
                                 "長崎県",
                                 "熊本県",
                                 "大分県",
                                 "宮崎県",
                                 "鹿児島県",
                                 "沖縄県"
                               ],
                               { include_blank: "活動地域を選択" },
                               class: "form-select form-select-lg" %>
                </div>

                <!-- 検索ボタン -->
                <div class="col-12 col-md-3 d-grid">
                  <%= f.submit "検索する",
                               class: "btn btn-primary btn-lg" %>
                </div>

              </div>

            <% end %>

          </div>
        </div>
      </div>

    </div>
  </section>


  <!-- 新着募集 -->
  <section>

    <div class="d-flex justify-content-between align-items-center mb-3">

      <h2 class="h4 fw-bold mb-0">
        新着の募集
      </h2>

      <%= link_to "すべて見る",
                  public_recruitments_path,
                  class: "text-decoration-none" %>

    </div>

    <% if Recruitment.exists? %>

      <div class="row g-4">

        <% Recruitment.includes(:theater)
                      .order(created_at: :desc)
                      .limit(3)
                      .each do |recruitment| %>

          <div class="col-12 col-md-4">

            <div class="card h-100 shadow-sm">

              <!-- 募集画像 -->
              <% if recruitment.image.attached? %>

                <%= image_tag recruitment.image,
                              class: "card-img-top",
                              style: "height: 160px; object-fit: cover;" %>

              <% else %>

                <div
                  class="bg-light d-flex align-items-center justify-content-center"
                  style="height: 160px;"
                >
                  <span class="text-muted">
                    募集イメージ未登録
                  </span>
                </div>

              <% end %>


              <div class="card-body">

                <h3 class="h6 fw-bold mb-2">
                  <%= recruitment.title %>
                </h3>

                <p class="text-muted small mb-2">
                  <%= recruitment.theater.name %>
                </p>

                <p class="small mb-3">
                  <%= recruitment.activity_area %>
                </p>

                <%= link_to "詳細を見る",
                            public_recruitment_path(recruitment),
                            class: "btn btn-outline-primary btn-sm" %>

              </div>

            </div>

          </div>

        <% end %>

      </div>

    <% else %>

      <div class="alert alert-light border">
        現在、新着募集はありません。
      </div>

    <% end %>

  </section>

</div>