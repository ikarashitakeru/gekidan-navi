<div class="container py-5">
  <div class="text-center mb-5">
    <h1 class="fw-bold mb-3">劇団ナビ</h1>
    <p class="text-muted">
      あなたに合った劇団・募集を探してみましょう
    </p>
  </div>

  <div class="row justify-content-center">
    <div class="col-12 col-lg-8">
      <div class="card shadow-sm border-0 p-4">

        <h2 class="h4 fw-bold mb-4">
          劇団を探す
        </h2>

        <%= form_with url: public_recruitments_path,
                      method: :get,
                      local: true do |f| %>

          <div class="mb-3">
            <%= f.label :keyword,
                        "劇団名・キーワード",
                        class: "form-label" %>

            <%= f.text_field :keyword,
                             class: "form-control",
                             placeholder: "例：ミュージカル、ダンス" %>
          </div>

          <div class="mb-4">
            <%= f.label :area,
                        "活動地域",
                        class: "form-label" %>

            <%= f.select :area,
                         ["東京都", "神奈川県", "大阪府", "京都府", "新潟県"],
                         { include_blank: "地域を選択" },
                         class: "form-select" %>
          </div>

          <div class="text-end">
            <%= f.submit "検索",
                         class: "btn btn-primary px-4" %>
          </div>

        <% end %>

      </div>
    </div>
  </div>
</div>
