<div class="container py-4 py-md-5">

  <h2 class="fw-bold mb-4">
    応募履歴
  </h2>

  <% if @applications.any? %>

    <div class="row g-3">

      <% @applications.each do |application| %>
        <div class="col-12">

          <div class="card shadow-sm h-100">
            <div class="card-body p-3 p-md-4">

              <h4 class="fw-bold mb-3">
                <%= application.recruitment.title %>
              </h4>

              <p class="mb-1">
                <strong>劇団名：</strong>
                <%= application.recruitment.theater.name %>
              </p>

              <p class="mb-1">
                <strong>応募日：</strong>
                <%= application.created_at.strftime("%Y年%m月%d日") %>
              </p>

              <p class="mb-3">
                <strong>選考状況：</strong>

                <% case application.selection_status %>
                <% when "applied" %>
                  応募済み
                <% when "screening" %>
                  選考中
                <% when "accepted" %>
                  合格
                <% when "rejected" %>
                  不合格
                <% end %>
              </p>

              <div class="d-grid d-md-block">
                <%= link_to "詳細を見る",
                            public_application_path(application),
                            class: "btn btn-outline-primary" %>
              </div>

            </div>
          </div>

        </div>
      <% end %>

    </div>

  <% else %>

    <div class="alert alert-light border">
      まだ応募履歴はありません。
    </div>

  <% end %>

</div>