<div class="container py-4 py-md-5">
  <div class="row justify-content-center">
    <div class="col-12 col-lg-8">

      <div class="card shadow-sm">
        <div class="card-body p-3 p-md-4">

          <h2 class="fw-bold mb-4">
            応募フォーム
          </h2>

          <div class="mb-4">
            <h4 class="fw-bold">
              <%= @recruitment.title %>
            </h4>

            <p class="text-muted mb-1">
              劇団名：<%= @recruitment.theater.name %>
            </p>

            <p class="text-muted mb-0">
              活動地域：<%= @recruitment.activity_area %>
            </p>
          </div>

          <%= form_with model: @application,
                        url: public_recruitment_applications_path(@recruitment),
                        local: true do |f| %>

            <% if @application.errors.any? %>
              <div class="alert alert-danger">
                <ul class="mb-0">
                  <% @application.errors.full_messages.each do |message| %>
                    <li><%= message %></li>
                  <% end %>
                </ul>
              </div>
            <% end %>

            <div class="mb-4">
              <%= f.label :motivation,
                          "志望動機",
                          class: "form-label" %>

              <%= f.text_area :motivation,
                              rows: 7,
                              class: "form-control",
                              placeholder: "応募理由や意気込みを入力してください" %>
            </div>

            <div class="d-grid d-md-flex gap-2 gap-md-3">
              <%= f.submit "応募する",
                           class: "btn btn-primary" %>

              <%= link_to "戻る",
                          public_recruitment_path(@recruitment),
                          class: "btn btn-outline-secondary" %>
            </div>

          <% end %>

        </div>
      </div>

    </div>
  </div>
</div>