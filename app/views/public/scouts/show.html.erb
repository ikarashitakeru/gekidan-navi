<div class="container py-4 py-md-5">

  <div class="row justify-content-center">
    <div class="col-12 col-lg-8">

      <div class="mb-3">
        <%= link_to "← スカウト一覧に戻る",
                    public_scouts_path,
                    class: "text-decoration-none" %>
      </div>

      <div class="mb-4">
        <h2 class="fw-bold mb-1">
          スカウト詳細
        </h2>

        <p class="text-muted mb-0">
          劇団から届いたスカウトの内容を確認できます。
        </p>
      </div>

      <% if notice.present? %>
        <div class="alert alert-success">
          <%= notice %>
        </div>
      <% end %>

      <div class="card shadow-sm border-0">
        <div class="card-body p-4">

          <div class="mb-4">

            <p class="text-muted small mb-1">
              劇団名
            </p>

            <h3 class="h4 fw-bold mb-0">
              <%= @scout.theater.name %>
            </h3>

          </div>

          <hr>

          <div class="mb-4">

            <h4 class="h6 fw-bold mb-2">
              案内された募集
            </h4>

            <p class="mb-2">
              <%= @scout.recruitment.title %>
            </p>

            <%= link_to "募集詳細を見る",
                        public_recruitment_path(@scout.recruitment),
                        class: "btn btn-outline-primary btn-sm" %>

          </div>

          <div class="mb-4">

            <h4 class="h6 fw-bold mb-2">
              メッセージ
            </h4>

            <div class="bg-light rounded p-3">
              <%= simple_format(@scout.message) %>
            </div>

          </div>

          <div class="mb-4">

            <h4 class="h6 fw-bold mb-2">
              スカウト状況
            </h4>

            <% if @scout.sent? %>

              <span class="badge text-bg-secondary">
                未回答
              </span>

            <% elsif @scout.accepted? %>

              <span class="badge text-bg-success">
                承諾済み
              </span>

            <% elsif @scout.declined? %>

              <span class="badge text-bg-danger">
                辞退済み
              </span>

            <% end %>

          </div>

          <% if @scout.sent? %>

            <hr>

            <div class="d-flex gap-2">

              <%= button_to "承諾する",
                            accept_public_scout_path(@scout),
                            method: :patch,
                            onclick: "return confirm('このスカウトを承諾しますか？');",
                            class: "btn btn-success px-4" %>

              <%= button_to "辞退する",
                            decline_public_scout_path(@scout),
                            method: :patch,
                            onclick: "return confirm('このスカウトを辞退しますか？');",
                            class: "btn btn-outline-danger px-4" %>

            </div>

          <% end %>

        </div>
      </div>

    </div>
  </div>

</div>