<div class="container py-4 py-md-5">

  <div class="row justify-content-center">
    <div class="col-12 col-xl-9">

      <div class="mb-4">

        <h2 class="fw-bold mb-1">
          募集情報編集
        </h2>

        <p class="text-muted mb-0">
          劇団からの依頼内容に基づいて募集情報を編集します。
        </p>

      </div>

      <div class="card shadow-sm border-0">
        <div class="card-body p-4 p-md-5">

          <% if @recruitment.errors.any? %>

            <div class="alert alert-danger">

              <ul class="mb-0">

                <% @recruitment.errors.full_messages.each do |message| %>
                  <li><%= message %></li>
                <% end %>

              </ul>

            </div>

          <% end %>

          <%= form_with model: [:admin, @recruitment],
                        local: true do |f| %>

            <!-- 劇団名 -->
            <div class="mb-4">

              <label class="form-label fw-bold">
                劇団名
              </label>

              <input
                type="text"
                class="form-control"
                value="<%= @recruitment.theater.name %>"
                disabled
              >

            </div>

            <!-- 募集タイトル -->
            <div class="mb-4">

              <%= f.label :title,
                          "募集タイトル",
                          class: "form-label fw-bold" %>

              <%= f.text_field :title,
                               class: "form-control" %>

            </div>

            <!-- 募集内容 -->
            <div class="mb-4">

              <%= f.label :description,
                          "募集内容",
                          class: "form-label fw-bold" %>

              <%= f.text_area :description,
                              rows: 6,
                              class: "form-control" %>

            </div>

            <!-- 募集人数 -->
            <div class="mb-4">

              <%= f.label :capacity,
                          "募集人数",
                          class: "form-label fw-bold" %>

              <%= f.number_field :capacity,
                                 min: 1,
                                 class: "form-control" %>

            </div>

            <!-- 活動地域 -->
            <div class="mb-4">

              <%= f.label :activity_area,
                          "活動地域",
                          class: "form-label fw-bold" %>

              <%= f.select :activity_area,
                           [
                             "東京都",
                             "神奈川県",
                             "千葉県",
                             "埼玉県",
                             "大阪府",
                             "京都府",
                             "兵庫県",
                             "新潟県"
                           ],
                           {
                             include_blank: "活動地域を選択"
                           },
                           class: "form-select" %>

            </div>

            <!-- 応募締切 -->
            <div class="mb-4">

              <%= f.label :deadline,
                          "応募締切",
                          class: "form-label fw-bold" %>

              <%= f.date_field :deadline,
                               class: "form-control" %>

            </div>

            <!-- 募集状態 -->
            <div class="mb-4">

              <%= f.label :status,
                          "募集状態",
                          class: "form-label fw-bold" %>

              <%= f.select :status,
                           [
                             ["募集中", "open"],
                             ["募集終了", "closed"]
                           ],
                           {},
                           class: "form-select" %>

            </div>

            <div class="d-flex gap-2">

              <%= f.submit "変更を保存",
                           class: "btn btn-primary px-4" %>

              <%= link_to "募集詳細に戻る",
                          admin_recruitment_path(@recruitment),
                          class: "btn btn-outline-secondary px-4" %>

            </div>

          <% end %>

        </div>
      </div>

    </div>
  </div>

</div>