<div class="container py-5">

  <div class="mb-4">
    <h2 class="fw-bold mb-1">
      劇団員募集一覧
    </h2>

    <p class="text-muted mb-0">
      劇団から依頼があった場合、募集内容の編集・削除ができます。
    </p>
  </div>

  <% if notice.present? %>
    <div class="alert alert-success">
      <%= notice %>
    </div>
  <% end %>

  <% if @recruitments.any? %>

    <div class="table-responsive">
      <table class="table table-hover align-middle">

        <thead class="table-light">
          <tr>
            <th>募集ID</th>
            <th>募集タイトル</th>
            <th>劇団名</th>
            <th>活動地域</th>
            <th>応募締切</th>
            <th>募集状態</th>
            <th>操作</th>
          </tr>
        </thead>

        <tbody>

          <% @recruitments.each do |recruitment| %>

            <tr>

              <td>
                <%= recruitment.id %>
              </td>

              <td>
                <%= recruitment.title %>
              </td>

              <td>
                <%= recruitment.theater.name %>
              </td>

              <td>
                <%= recruitment.activity_area.presence || "未登録" %>
              </td>

              <td>
                <%= recruitment.deadline %>
              </td>

              <td>
                <% if recruitment.open? %>
                  <span class="badge text-bg-success">
                    募集中
                  </span>
                <% else %>
                  <span class="badge text-bg-secondary">
                    募集終了
                  </span>
                <% end %>
              </td>

              <td>
                <div class="d-flex gap-2">

                  <%= link_to "詳細",
                              admin_recruitment_path(recruitment),
                              class: "btn btn-outline-primary btn-sm" %>

                  <%= link_to "編集",
                              edit_admin_recruitment_path(recruitment),
                              class: "btn btn-outline-secondary btn-sm" %>

                  <%= button_to "削除",
                                admin_recruitment_path(recruitment),
                                method: :delete,
                                class: "btn btn-outline-danger btn-sm",
                                onclick: "return confirm('この募集を削除しますか？');" %>

                </div>
              </td>

            </tr>

          <% end %>

        </tbody>

      </table>
    </div>

  <% else %>

    <div class="alert alert-light border">
      登録されている募集はありません。
    </div>

  <% end %>

</div>