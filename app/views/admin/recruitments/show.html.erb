<div class="container py-5">
  <h2 class="fw-bold mb-4">劇団員募集詳細</h2>

  <div class="card shadow-sm">
    <div class="card-body p-4">

      <table class="table">
        <tbody>
          <tr>
            <th style="width: 30%;">募集ID</th>
            <td><%= @recruitment.id %></td>
          </tr>

          <tr>
            <th>募集タイトル</th>
            <td><%= @recruitment.title.presence || "未登録" %></td>
          </tr>

          <tr>
            <th>劇団名</th>
            <td><%= @recruitment.theater.name %></td>
          </tr>

          <tr>
            <th>募集内容</th>
            <td><%= @recruitment.description.presence || "未登録" %></td>
          </tr>

          <tr>
            <th>募集人数</th>
            <td>
              <% if @recruitment.capacity.present? %>
                <%= @recruitment.capacity %>人
              <% else %>
                未登録
              <% end %>
            </td>
          </tr>

          <tr>
            <th>活動地域</th>
            <td><%= @recruitment.activity_area.presence || "未登録" %></td>
          </tr>

          <tr>
            <th>応募締切</th>
            <td><%= @recruitment.deadline.presence || "未登録" %></td>
          </tr>

          <tr>
            <th>募集状態</th>
            <td><%= @recruitment.status.presence || "未登録" %></td>
          </tr>
        </tbody>
      </table>

      <div class="d-flex gap-3">
        <%= link_to "募集一覧に戻る",
                    admin_recruitments_path,
                    class: "btn btn-outline-secondary" %>

        <%= link_to "劇団詳細を見る",
                    admin_theater_path(@recruitment.theater),
                    class: "btn btn-outline-primary" %>
      </div>

    </div>
  </div>
</div>