<div class="container py-5">
  <div class="mb-4">
    <h2 class="fw-bold">管理者トップ</h2>
    <p class="text-muted mb-0">
      劇団ナビの各種情報を管理できます。
    </p>
  </div>

  <div class="row g-4">

    <!-- 会員管理 -->
    <div class="col-12 col-md-6">
      <div class="card shadow-sm h-100">
        <div class="card-body p-4">
          <h4 class="fw-bold">会員管理</h4>

          <p class="text-muted">
            登録されている会員の情報確認・利用状態の管理ができます。
          </p>

          <%= link_to "会員一覧を見る",
                      admin_users_path,
                      class: "btn btn-primary" %>
        </div>
      </div>
    </div>

    <!-- 劇団管理 -->
    <div class="col-12 col-md-6">
      <div class="card shadow-sm h-100">
        <div class="card-body p-4">
          <h4 class="fw-bold">劇団管理</h4>

          <p class="text-muted">
            登録されている劇団の情報を確認できます。
          </p>

          <%= link_to "劇団一覧を見る",
                      admin_theaters_path,
                      class: "btn btn-primary" %>
        </div>
      </div>
    </div>

    <!-- 募集管理 -->
    <div class="col-12 col-md-6">
      <div class="card shadow-sm h-100">
        <div class="card-body p-4">
          <h4 class="fw-bold">劇団員募集管理</h4>

          <p class="text-muted">
            劇団が登録した劇団員募集の内容を確認できます。
          </p>

          <%= link_to "募集一覧を見る",
                      admin_recruitments_path,
                      class: "btn btn-primary" %>
        </div>
      </div>
    </div>

    <!-- ジャンル管理 -->
    <div class="col-12 col-md-6">
      <div class="card shadow-sm h-100">
        <div class="card-body p-4">
          <h4 class="fw-bold">ジャンル管理</h4>

          <p class="text-muted">
            募集で使用するジャンルの追加・編集・削除ができます。
          </p>

          <%= link_to "ジャンルを管理する",
                      admin_genres_path,
                      class: "btn btn-primary" %>
        </div>
      </div>
    </div>

  </div>
</div>