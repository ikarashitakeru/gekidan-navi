<div class="container py-5">
  <h2 class="fw-bold mb-4">会員詳細</h2>

  <div class="card shadow-sm">
    <div class="card-body p-4">

      <table class="table">
        <tbody>
          <tr>
            <th style="width: 30%;">会員ID</th>
            <td><%= @user.id %></td>
          </tr>

          <tr>
            <th>氏名</th>
            <td><%= @user.name %></td>
          </tr>

          <tr>
            <th>メールアドレス</th>
            <td><%= @user.email %></td>
          </tr>

          <tr>
            <th>自己紹介</th>
            <td><%= @user.introduction.presence || "未登録" %></td>
          </tr>

          <tr>
            <th>演技経験</th>
            <td><%= @user.acting_experience.presence || "未登録" %></td>
          </tr>

          <tr>
            <th>歌唱経験</th>
            <td><%= @user.singing_experience.presence || "未登録" %></td>
          </tr>

          <tr>
            <th>ダンス経験</th>
            <td><%= @user.dance_experience.presence || "未登録" %></td>
          </tr>

          <tr>
            <th>希望地域</th>
            <td><%= @user.preferred_area.presence || "未登録" %></td>
          </tr>

          <tr>
            <th>利用状態</th>
            <td>
              <% if @user.is_active? %>
                <span class="text-success fw-bold">利用中</span>
              <% else %>
                <span class="text-danger fw-bold">利用停止中</span>
              <% end %>
            </td>
          </tr>
        </tbody>
      </table>

      <div class="d-flex gap-3">

        <%= link_to "会員一覧に戻る",
                    admin_users_path,
                    class: "btn btn-outline-secondary" %>

        <% if @user.is_active? %>

          <%= button_to "利用停止にする",
                        toggle_status_admin_user_path(@user),
                        method: :patch,
                        data: {
                          turbo_confirm: "この会員を利用停止にしますか？"
                        },
                        class: "btn btn-outline-danger" %>

        <% else %>

          <%= button_to "利用再開する",
                        toggle_status_admin_user_path(@user),
                        method: :patch,
                        data: {
                          turbo_confirm: "この会員の利用を再開しますか？"
                        },
                        class: "btn btn-outline-success" %>

        <% end %>

      </div>

    </div>
  </div>
</div>