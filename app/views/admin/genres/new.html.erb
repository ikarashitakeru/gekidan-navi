<div class="container py-5">
  <h2 class="fw-bold mb-4">ジャンル追加</h2>

  <div class="card shadow-sm">
    <div class="card-body p-4">

      <% if @genre.errors.any? %>
        <div class="alert alert-danger">
          <ul class="mb-0">
            <% @genre.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <%= form_with model: [:admin, @genre] do |f| %>

        <div class="mb-4">
          <%= f.label :name, "ジャンル名", class: "form-label" %>
          <%= f.text_field :name,
                           class: "form-control",
                           placeholder: "例：ミュージカル" %>
        </div>

        <div class="d-flex gap-3">
          <%= f.submit "追加する", class: "btn btn-primary" %>

          <%= link_to "ジャンル一覧に戻る",
                      admin_genres_path,
                      class: "btn btn-outline-secondary" %>
        </div>

      <% end %>

    </div>
  </div>
</div>