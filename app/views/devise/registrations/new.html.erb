<div class="container py-5">
  <div class="row justify-content-center">
    <div class="col-12 col-md-6 col-lg-5">

      <% if resource_name == :user %>
        <h2 class="text-center fw-bold mb-4">
          ユーザー新規登録
        </h2>
      <% else %>
        <h2 class="text-center fw-bold mb-4">
          劇団新規登録
        </h2>
      <% end %>

      <%= form_for(resource,
                   as: resource_name,
                   url: registration_path(resource_name)) do |f| %>

        <%= render "devise/shared/error_messages",
                   resource: resource %>

        <!-- 名前 -->
        <div class="mb-3">
          <% if resource_name == :user %>

            <%= f.label :name,
                        "氏名",
                        class: "form-label" %>

            <%= f.text_field :name,
                             autofocus: true,
                             class: "form-control" %>

          <% else %>

            <%= f.label :name,
                        "劇団名",
                        class: "form-label" %>

            <%= f.text_field :name,
                             autofocus: true,
                             class: "form-control" %>

          <% end %>
        </div>


        <% if resource_name == :theater %>
          <div class="mb-3">
            <%= f.label :activity_area,
                        "活動地域",
                        class: "form-label" %>

            <%= f.text_field :activity_area,
                             class: "form-control",
                             placeholder: "例：東京都" %>
          </div>
        <% end %>

        <!-- メールアドレス -->
        <div class="mb-3">
          <%= f.label :email,
                      "メールアドレス",
                      class: "form-label" %>

          <%= f.email_field :email,
                            autocomplete: "email",
                            class: "form-control" %>
        </div>

        <!-- パスワード -->
        <div class="mb-3">
          <%= f.label :password,
                      "パスワード",
                      class: "form-label" %>

          <% if @minimum_password_length %>
            <small class="text-muted">
              （<%= @minimum_password_length %>文字以上）
            </small>
          <% end %>

          <%= f.password_field :password,
                               autocomplete: "new-password",
                               class: "form-control" %>
        </div>

        <!-- パスワード確認 -->
        <div class="mb-4">
          <%= f.label :password_confirmation,
                      "パスワード（確認）",
                      class: "form-label" %>

          <%= f.password_field :password_confirmation,
                               autocomplete: "new-password",
                               class: "form-control" %>
        </div>

        <!-- 登録ボタン -->
        <div class="d-grid">
          <%= f.submit "新規登録",
                       class: "btn btn-primary" %>
        </div>

      <% end %>

      <div class="text-center mt-4">
        <%= render "devise/shared/links" %>
      </div>

    </div>
  </div>
</div>