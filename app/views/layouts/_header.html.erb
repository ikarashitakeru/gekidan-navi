<header class="border-bottom bg-white">
  <nav class="navbar navbar-expand-lg navbar-light bg-white">
    <div class="container py-2">

      <%= link_to "劇団ナビ",
                  root_path,
                  class: "navbar-brand fw-bold fs-4" %>

      <button class="navbar-toggler"
              type="button"
              data-bs-toggle="collapse"
              data-bs-target="#navbarMenu"
              aria-controls="navbarMenu"
              aria-expanded="false"
              aria-label="メニューを開く">
        <span class="navbar-toggler-icon"></span>
      </button>

      <div class="collapse navbar-collapse" id="navbarMenu">
        <div class="navbar-nav ms-auto align-items-lg-center gap-lg-3">

          <% if admin_signed_in? %>

            <%= link_to "管理者トップ",
                        admin_root_path,
                        class: "nav-link" %>

            <%= link_to "会員一覧",
                        admin_users_path,
                        class: "nav-link" %>

            <%= link_to "劇団一覧",
                        admin_theaters_path,
                        class: "nav-link" %>

            <%= link_to "募集一覧",
                        admin_recruitments_path,
                        class: "nav-link" %>

            <%= link_to "ジャンル管理",
                        admin_genres_path,
                        class: "nav-link" %>

            <div class="nav-item">
              <%= button_to "ログアウト",
                            destroy_admin_session_path,
                            method: :delete,
                            class: "btn btn-link nav-link text-start p-0" %>
            </div>

          <% elsif user_signed_in? %>

            <%= link_to "ホーム",
                        root_path,
                        class: "nav-link" %>

            <%= link_to "募集を探す",
                        public_recruitments_path,
                        class: "nav-link" %>

            <%= link_to "マイページ",
                        public_user_path,
                        class: "nav-link" %>

            <%= link_to "応募履歴",
                        public_applications_path,
                        class: "nav-link" %>

            <%= link_to "スカウト",
                        public_scouts_path,
                        class: "nav-link" %>

            <div class="nav-item">
              <%= button_to "ログアウト",
                            destroy_user_session_path,
                            method: :delete,
                            class: "btn btn-link nav-link text-start p-0" %>
            </div>

          <% elsif theater_signed_in? %>

            <%= link_to "劇団マイページ",
                        theater_root_path,
                        class: "nav-link" %>

            <%= link_to "募集管理",
                        theater_recruitments_path,
                        class: "nav-link" %>

            <%= link_to "応募者管理",
                        theater_applications_path,
                        class: "nav-link" %>

            <%= link_to "ユーザー検索",
                        theater_users_path,
                        class: "nav-link" %>

            <%= link_to "スカウト",
                        theater_scouts_path,
                        class: "nav-link" %>

            <div class="nav-item">
              <%= button_to "ログアウト",
                            destroy_theater_session_path,
                            method: :delete,
                            class: "btn btn-link nav-link text-start p-0" %>
            </div>

          <% else %>

            <%= link_to "ホーム",
                        root_path,
                        class: "nav-link" %>

            <%= link_to "募集を探す",
                        public_recruitments_path,
                        class: "nav-link" %>

            <%= link_to "ユーザーログイン",
                        new_user_session_path,
                        class: "nav-link" %>

            <%= link_to "ユーザー新規登録",
                        new_user_registration_path,
                        class: "nav-link" %>

            <%= link_to "劇団ログイン",
                        new_theater_session_path,
                        class: "nav-link" %>

            <%= link_to "劇団新規登録",
                        new_theater_registration_path,
                        class: "nav-link" %>

          <% end %>

        </div>
      </div>

    </div>
  </nav>
</header>