<div class="container py-4 py-md-5">

  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h2 class="fw-bold mb-1">募集一覧</h2>
      <p class="text-muted mb-0">
        作成した募集の確認・編集ができます。
      </p>
    </div>

    <%= link_to "新規募集を作成",
                new_theater_recruitment_path,
                class: "btn btn-primary" %>
  </div>

  <% if @recruitments.any? %>

    <div class="card shadow-sm border-0">
      <div class="card-body p-0">

        <div class="table-responsive">
          <table class="table align-middle mb-0">

            <thead class="table-light">
              <tr>
                <th class="px-4 py-3">募集タイトル</th>
                <th class="py-3">応募数</th>
                <th class="py-3">締切</th>
                <th class="py-3">ステータス</th>
                <th class="py-3 text-end pe-4">操作</th>
              </tr>
            </thead>

            <tbody>
              <% @recruitments.each do |recruitment| %>

                <tr>

                  <td class="px-4 py-3">
                    <div class="fw-bold">
                      <%= recruitment.title %>
                    </div>

                    <div class="small text-muted mt-1">
                      <%= recruitment.activity_area %>
                    </div>
                  </td>

                  <td>
                    <%= recruitment.applications.count %>人
                  </td>

                  <td>
                    <%= recruitment.deadline %>
                  </td>

                  <td>
                    <% if recruitment.open? %>
                      <span class="badge text-bg-success">
                        募集中
                      </span>
                    <% else %>
                      <span class="badge text-bg-secondary">
                        募集終了
                      </span>
                    <% end %>
                  </td>

                  <td class="text-end pe-4">

                    <div class="d-flex justify-content-end gap-2">

                      <%= link_to "詳細",
                                  theater_recruitment_path(recruitment),
                                  class: "btn btn-outline-primary btn-sm" %>

                      <%= link_to "編集",
                                  edit_theater_recruitment_path(recruitment),
                                  class: "btn btn-outline-secondary btn-sm" %>

                    </div>

                  </td>

                </tr>

              <% end %>
            </tbody>

          </table>
        </div>

      </div>
    </div>

  <% else %>

    <div class="card shadow-sm border-0">
      <div class="card-body text-center py-5">

        <h3 class="h5 fw-bold mb-3">
          まだ募集を投稿していません
        </h3>

        <p class="text-muted mb-4">
          新しい劇団員募集を作成してみましょう。
        </p>

        <%= link_to "新規募集を作成",
                    new_theater_recruitment_path,
                    class: "btn btn-primary" %>

      </div>
    </div>

  <% end %>

</div>