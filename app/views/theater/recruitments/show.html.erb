<div class="container py-4 py-md-5">

  <div class="row justify-content-center">
    <div class="col-12 col-xl-10">

      <div class="mb-4">
        <p class="text-muted mb-2">
          募集詳細
        </p>

        <h2 class="fw-bold mb-2">
          <%= @recruitment.title.presence || "タイトル未登録" %>
        </h2>

        <p class="text-muted mb-0">
          <%= @recruitment.theater.name %>
        </p>
      </div>

      <div class="row g-4">

        <div class="col-12 col-lg-8">

          <div class="card shadow-sm border-0 mb-4">
            <div class="card-body p-4">

              <% if @recruitment.image.attached? %>

                <%= image_tag @recruitment.image,
                              class: "img-fluid rounded mb-3 w-100",
                              style: "height: 280px; object-fit: cover;" %>

              <% else %>

                <div class="bg-dark rounded d-flex align-items-center justify-content-center mb-3"
                     style="height: 280px;">

                  <span class="text-white-50">
                    募集イメージ未登録
                  </span>

                </div>

              <% end %>

              <!-- Vision APIで取得したタグ -->
              <% if @recruitment.tags.any? %>
                <div class="mb-4">
                  <p class="small text-muted mb-2">
                    画像タグ
                  </p>

                  <% @recruitment.tags.each do |tag| %>
                    <span class="badge text-bg-info me-1">
                      <%= tag.name %>
                    </span>
                  <% end %>
                </div>
              <% end %>

              <h3 class="h5 fw-bold mb-3">
                募集内容
              </h3>

              <% if @recruitment.description.present? %>

                <div class="text-muted">
                  <%= simple_format(@recruitment.description) %>
                </div>

              <% else %>

                <p class="text-muted mb-0">
                  未登録
                </p>

              <% end %>

            </div>
          </div>

        </div>

        <div class="col-12 col-lg-4">

          <div class="card shadow-sm border-0">
            <div class="card-body p-4">

              <h3 class="h5 fw-bold mb-4">
                募集情報
              </h3>

              <div class="mb-3">
                <p class="small text-muted mb-1">
                  劇団名
                </p>

                <p class="fw-bold mb-0">
                  <%= @recruitment.theater.name %>
                </p>
              </div>

              <hr>

              <div class="mb-3">
                <p class="small text-muted mb-1">
                  ジャンル
                </p>

                <p class="mb-0">
                  <%= @recruitment.genre&.name || "未登録" %>
                </p>
              </div>

              <hr>

              <div class="mb-3">
                <p class="small text-muted mb-1">
                  活動地域
                </p>

                <p class="mb-0">
                  <%= @recruitment.activity_area.presence || "未登録" %>
                </p>
              </div>

              <hr>

              <div class="mb-3">
                <p class="small text-muted mb-1">
                  募集人数
                </p>

                <p class="mb-0">
                  <%= @recruitment.capacity.present? ? "#{@recruitment.capacity}名" : "未登録" %>
                </p>
              </div>

              <hr>

              <div class="mb-3">
                <p class="small text-muted mb-1">
                  応募締切
                </p>

                <p class="mb-0">
                  <%= @recruitment.deadline || "未登録" %>
                </p>
              </div>

              <hr>

              <div>
                <p class="small text-muted mb-1">
                  募集状態
                </p>

                <% if @recruitment.open? %>
                  <span class="badge text-bg-success">
                    募集中
                  </span>
                <% else %>
                  <span class="badge text-bg-secondary">
                    募集終了
                  </span>
                <% end %>
              </div>

            </div>
          </div>

        </div>

      </div>

      <div class="card shadow-sm border-0 mt-4">
        <div class="card-body p-4">

          <div class="d-grid d-md-flex gap-3 justify-content-md-center">

            <%= link_to "編集",
                        edit_theater_recruitment_path(@recruitment),
                        class: "btn btn-primary px-4" %>

            <%= button_to "削除",
                          theater_recruitment_path(@recruitment),
                          method: :delete,
                          onclick: "return confirm('この募集を削除しますか？');",
                          class: "btn btn-danger px-4" %>

            <%= link_to "募集一覧へ戻る",
                        theater_recruitments_path,
                        class: "btn btn-outline-secondary px-4" %>

          </div>

        </div>
      </div>

    </div>
  </div>

</div>