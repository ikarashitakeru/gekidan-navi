<div class="container py-5">
  <div class="row justify-content-center">
    <div class="col-12 col-lg-9">

      <div class="mb-3">
        <%= link_to "← 募集一覧に戻る",
                    theater_recruitments_path,
                    class: "text-decoration-none" %>
      </div>

      <div class="mb-4">
        <p class="text-muted mb-1">
          募集詳細
        </p>

        <h2 class="fw-bold mb-2">
          <%= @recruitment.title.presence || "タイトル未登録" %>
        </h2>

        <p class="text-muted mb-0">
          <%= @recruitment.theater.name %>
        </p>
      </div>

      <div class="card shadow-sm border-0">
        <div class="card-body p-4 p-md-5">

          <div class="mb-4">
            <h3 class="h6 fw-bold mb-2">
              ジャンル
            </h3>

            <p class="mb-0">
              <%= @recruitment.genre&.name || "未設定" %>
            </p>
          </div>

          <hr>

          <div class="mb-4">
            <h3 class="h6 fw-bold mb-2">
              募集内容
            </h3>

            <% if @recruitment.description.present? %>
              <%= simple_format(@recruitment.description) %>
            <% else %>
              <p class="mb-0 text-muted">
                未登録
              </p>
            <% end %>
          </div>

          <hr>

          <div class="row g-4">

            <div class="col-12 col-md-6">
              <h3 class="h6 fw-bold mb-2">
                募集人数
              </h3>

              <p class="mb-0">
                <%= @recruitment.capacity.present? ? "#{@recruitment.capacity}名" : "未登録" %>
              </p>
            </div>

            <div class="col-12 col-md-6">
              <h3 class="h6 fw-bold mb-2">
                応募締切
              </h3>

              <p class="mb-0">
                <%= @recruitment.deadline || "未登録" %>
              </p>
            </div>

            <div class="col-12 col-md-6">
              <h3 class="h6 fw-bold mb-2">
                活動地域
              </h3>

              <p class="mb-0">
                <%= @recruitment.activity_area.presence || "未登録" %>
              </p>
            </div>

            <div class="col-12 col-md-6">
              <h3 class="h6 fw-bold mb-2">
                募集状態
              </h3>

              <% if @recruitment.open? %>
                <span class="badge text-bg-success">
                  募集中
                </span>
              <% else %>
                <span class="badge text-bg-secondary">
                  募集終了
                </span>
              <% end %>
            </div>

            <div class="col-12 col-md-6">
              <h3 class="h6 fw-bold mb-2">
                応募者数
              </h3>

              <p class="mb-0">
                <%= @recruitment.applications.count %>人
              </p>
            </div>

          </div>

          <hr class="my-4">

          <div class="d-flex flex-wrap gap-2">

            <%= link_to "編集",
                        edit_theater_recruitment_path(@recruitment),
                        class: "btn btn-primary" %>

            <%= button_to "削除",
                          theater_recruitment_path(@recruitment),
                          method: :delete,
                          onclick: "return confirm('この募集を削除しますか？');",
                          class: "btn btn-danger" %>

            <%= link_to "募集一覧へ戻る",
                        theater_recruitments_path,
                        class: "btn btn-outline-secondary" %>

          </div>

        </div>
      </div>

    </div>
  </div>
</div>