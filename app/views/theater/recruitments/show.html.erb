<div class="container py-5">
  <div class="row justify-content-center">
    <div class="col-12 col-md-8">

      <div class="card shadow-sm">
        <div class="card-body p-4">

          <h2 class="fw-bold mb-4">
            <%= @recruitment.title %>
          </h2>

          <div class="mb-3">
            <strong>募集内容</strong>
            <p class="mt-1">
              <%= simple_format(@recruitment.description) %>
            </p>
          </div>

          <div class="mb-3">
            <strong>募集人数</strong>
            <p class="mb-0">
              <%= @recruitment.capacity %>名
            </p>
          </div>

          <div class="mb-3">
            <strong>応募締切</strong>
            <p class="mb-0">
              <%= @recruitment.deadline %>
            </p>
          </div>

          <div class="mb-3">
            <strong>活動地域</strong>
            <p class="mb-0">
              <%= @recruitment.activity_area %>
            </p>
          </div>

          <div class="mb-4">
            <strong>募集状態</strong>
            <p class="mb-0">
              <%= @recruitment.open? ? "募集中" : "募集終了" %>
            </p>
          </div>

          <div class="d-flex gap-3">
            <%= link_to "編集",
                        edit_theater_recruitment_path(@recruitment),
                        class: "btn btn-primary" %>

            <%= button_to "削除",
                          theater_recruitment_path(@recruitment),
                          method: :delete,
                          data: { turbo_confirm: "この募集を削除しますか？" },
                          class: "btn btn-danger" %>

            <%= link_to "募集一覧へ戻る",
                        theater_recruitments_path,
                        class: "btn btn-outline-secondary" %>
          </div>

        </div>
      </div>

    </div>
  </div>
</div>