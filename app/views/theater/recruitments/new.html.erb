<div class="container py-5">
  <div class="row justify-content-center">
    <div class="col-12 col-md-8">

      <div class="card shadow-sm">
        <div class="card-body p-4">

          <h2 class="fw-bold mb-4">
            募集を新規作成
          </h2>

          <%= form_with model: @recruitment,
                        url: theater_recruitments_path,
                        local: true do |f| %>

            <div class="mb-3">
              <%= f.label :title, "募集タイトル", class: "form-label" %>
              <%= f.text_field :title,
                               class: "form-control",
                               placeholder: "例：新作ミュージカル出演者募集" %>
            </div>

            <div class="mb-3">
              <%= f.label :description, "募集内容", class: "form-label" %>
              <%= f.text_area :description,
                              rows: 6,
                              class: "form-control",
                              placeholder: "募集内容や応募条件などを入力してください" %>
            </div>

            <div class="mb-3">
              <%= f.label :capacity, "募集人数", class: "form-label" %>
              <%= f.number_field :capacity,
                                 min: 1,
                                 class: "form-control",
                                 placeholder: "例：5" %>
            </div>

            <div class="mb-3">
              <%= f.label :deadline, "応募締切", class: "form-label" %>
              <%= f.date_field :deadline,
                               class: "form-control" %>
            </div>

            <div class="mb-3">
              <%= f.label :activity_area, "活動地域", class: "form-label" %>
              <%= f.text_field :activity_area,
                               class: "form-control",
                               placeholder: "例：東京都" %>
            </div>

            <div class="mb-4">
              <%= f.label :status, "募集状態", class: "form-label" %>
              <%= f.select :status,
                           [["募集中", "open"], ["募集終了", "closed"]],
                           {},
                           class: "form-select" %>
            </div>

            <div class="d-flex gap-3">
              <%= f.submit "募集を投稿",
                           class: "btn btn-primary" %>

              <%= link_to "戻る",
                          theater_recruitments_path,
                          class: "btn btn-outline-secondary" %>
            </div>

          <% end %>

        </div>
      </div>
    </div>
  </div>
</div>