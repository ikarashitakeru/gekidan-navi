<div class="container py-4 py-md-5">

  <div class="row justify-content-center">
    <div class="col-12 col-xl-10">

      <!-- 戻る -->
      <div class="mb-3">
        <%= link_to "← 応募者一覧に戻る",
                    theater_applications_path,
                    class: "text-decoration-none" %>
      </div>

      <div class="mb-4">
        <h2 class="fw-bold mb-1">応募者詳細</h2>

        <p class="text-muted mb-0">
          応募者のプロフィールと選考状況を確認できます。
        </p>
      </div>

      <div class="row g-4">

        <!-- 左：応募者情報 -->
        <div class="col-12 col-lg-8">

          <div class="card shadow-sm border-0 h-100">
            <div class="card-body p-4">

              <!-- 基本情報 -->
              <div class="d-flex align-items-center mb-4">

                <div class="bg-light border rounded-circle
                            d-flex align-items-center justify-content-center
                            flex-shrink-0 me-3"
                     style="width: 80px; height: 80px;">

                  <span class="text-muted small">
                    プロフィール
                  </span>

                </div>

                <div>
                  <h3 class="h4 fw-bold mb-1">
                    <%= @application.user.name %>
                  </h3>

                  <p class="text-muted mb-1">
                    希望地域：
                    <%= @application.user.preferred_area.presence || "未登録" %>
                  </p>

                  <p class="text-muted mb-0">
                    応募日：
                    <%= @application.created_at.strftime("%Y年%m月%d日") %>
                  </p>
                </div>

              </div>

              <hr>

              <!-- 応募した募集 -->
              <div class="mb-4">
                <div class="text-muted small mb-1">
                  応募した募集
                </div>

                <div class="fw-bold">
                  <%= @application.recruitment.title %>
                </div>
              </div>

              <!-- 演技経験 -->
              <div class="mb-4">
                <h4 class="h6 fw-bold mb-2">演技経験</h4>

                <p class="mb-0">
                  <%= @application.user.acting_experience.presence || "未登録" %>
                </p>
              </div>

              <!-- 歌唱経験 -->
              <div class="mb-4">
                <h4 class="h6 fw-bold mb-2">歌唱経験</h4>

                <p class="mb-0">
                  <%= @application.user.singing_experience.presence || "未登録" %>
                </p>
              </div>

              <!-- ダンス経験 -->
              <div class="mb-4">
                <h4 class="h6 fw-bold mb-2">ダンス経験</h4>

                <p class="mb-0">
                  <%= @application.user.dance_experience.presence || "未登録" %>
                </p>
              </div>

              <!-- 志望動機 -->
              <div>
                <h4 class="h6 fw-bold mb-2">志望動機</h4>

                <% if @application.motivation.present? %>
                  <%= simple_format(@application.motivation, class: "mb-0") %>
                <% else %>
                  <p class="text-muted mb-0">
                    志望動機は登録されていません。
                  </p>
                <% end %>
              </div>

            </div>
          </div>

        </div>


        <!-- 右：選考管理 -->
        <div class="col-12 col-lg-4">

          <div class="card shadow-sm border-0">
            <div class="card-body p-4">

              <h3 class="h5 fw-bold mb-4">
                選考ステータス
              </h3>

              <!-- 現在の状況 -->
              <div class="mb-4">
                <div class="text-muted small mb-2">
                  現在の状況
                </div>

                <% if @application.selection_status == "applied" %>

                  <span class="badge text-bg-secondary">
                    応募済み
                  </span>

                <% elsif @application.selection_status == "screening" %>

                  <span class="badge text-bg-warning">
                    選考中
                  </span>

                <% elsif @application.selection_status == "accepted" %>

                  <span class="badge text-bg-success">
                    合格
                  </span>

                <% elsif @application.selection_status == "rejected" %>

                  <span class="badge text-bg-danger">
                    不合格
                  </span>

                <% end %>
              </div>

              <%= form_with model: @application,
                            url: theater_application_path(@application),
                            method: :patch,
                            local: true do |f| %>

                <div class="mb-3">

                  <%= f.label :selection_status,
                              "選考状況を変更",
                              class: "form-label fw-bold" %>

                  <%= f.select :selection_status,
                               [
                                 ["応募済み", "applied"],
                                 ["選考中", "screening"],
                                 ["合格", "accepted"],
                                 ["不合格", "rejected"]
                               ],
                               {},
                               class: "form-select" %>

                </div>

                <div class="d-grid">
                  <%= f.submit "更新する",
                               class: "btn btn-primary" %>
                </div>

              <% end %>

            </div>
          </div>

        </div>

      </div>

    </div>
  </div>

</div>