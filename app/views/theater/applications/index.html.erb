<div class="container py-4 py-md-5">

  <div class="mb-4">
    <h2 class="fw-bold mb-1">応募者一覧</h2>

    <p class="text-muted mb-0">
      自劇団の募集に応募したユーザーを確認できます。
    </p>
  </div>

  <% if @applications.any? %>

    <div class="card shadow-sm border-0">
      <div class="card-body p-0">

        <div class="table-responsive">
          <table class="table align-middle mb-0">

            <thead class="table-light">
              <tr>
                <th class="px-4 py-3">氏名</th>
                <th class="py-3">応募した募集</th>
                <th class="py-3">希望地域</th>
                <th class="py-3">応募日</th>
                <th class="py-3">選考状況</th>
                <th class="py-3 text-end pe-4">操作</th>
              </tr>
            </thead>

            <tbody>

              <% @applications.each do |application| %>

                <tr>

                  <td class="px-4 py-3">
                    <strong>
                      <%= application.user.name %>
                    </strong>
                  </td>

                  <td>
                    <%= application.recruitment.title %>
                  </td>

                  <td>
                    <%= application.user.preferred_area.presence || "未登録" %>
                  </td>

                  <td>
                    <%= application.created_at.strftime("%Y年%m月%d日") %>
                  </td>

                  <td>

                    <% if application.selection_status == "applied" %>

                      <span class="badge text-bg-secondary">
                        応募済み
                      </span>

                    <% elsif application.selection_status == "screening" %>

                      <span class="badge text-bg-warning">
                        選考中
                      </span>

                    <% elsif application.selection_status == "accepted" %>

                      <span class="badge text-bg-success">
                        合格
                      </span>

                    <% elsif application.selection_status == "rejected" %>

                      <span class="badge text-bg-danger">
                        不合格
                      </span>

                    <% else %>

                      <span class="badge text-bg-secondary">
                        状況未設定
                      </span>

                    <% end %>

                  </td>

                  <td class="text-end pe-4">

                    <%= link_to "詳細",
                                theater_application_path(application),
                                class: "btn btn-outline-primary btn-sm" %>

                  </td>

                </tr>

              <% end %>

            </tbody>

          </table>
        </div>

      </div>
    </div>

  <% else %>

    <div class="card shadow-sm border-0">
      <div class="card-body text-center py-5">

        <h3 class="h5 fw-bold mb-3">
          現在、応募者はいません
        </h3>

        <p class="text-muted mb-0">
          募集への応募があると、ここに表示されます。
        </p>

      </div>
    </div>

  <% end %>

</div>