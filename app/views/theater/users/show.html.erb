<div class="container py-4 py-md-5">

  <div class="row justify-content-center">
    <div class="col-12 col-xl-9">

      <div class="mb-3">
        <%= link_to "← ユーザー一覧に戻る",
                    theater_users_path,
                    class: "text-decoration-none" %>
      </div>

      <div class="mb-4">
        <h2 class="fw-bold mb-1">
          ユーザープロフィール
        </h2>

        <p class="text-muted mb-0">
          ユーザーのプロフィールや経験を確認できます。
        </p>
      </div>

      <div class="card shadow-sm border-0">
        <div class="card-body p-4 p-md-5">

          <!-- 基本情報 -->
          <div class="d-flex align-items-center mb-4">

            <div class="bg-light border rounded-circle
                        d-flex align-items-center justify-content-center
                        flex-shrink-0 me-3"
                 style="width: 90px; height: 90px;">

              <span class="text-muted small">
                プロフィール
              </span>

            </div>

            <div>
              <h3 class="h4 fw-bold mb-1">
                <%= @user.name %>
              </h3>

              <p class="text-muted mb-0">
                希望地域：
                <%= @user.preferred_area.presence || "未登録" %>
              </p>
            </div>

          </div>

          <hr class="mb-4">

          <!-- 自己紹介 -->
          <div class="mb-4">
            <h4 class="h6 fw-bold mb-2">
              自己紹介
            </h4>

            <p class="mb-0">
              <%= @user.introduction.presence || "未登録" %>
            </p>
          </div>

          <!-- 演技経験 -->
          <div class="mb-4">
            <h4 class="h6 fw-bold mb-2">
              演技経験
            </h4>

            <p class="mb-0">
              <%= @user.acting_experience.presence || "未登録" %>
            </p>
          </div>

          <!-- 歌唱経験 -->
          <div class="mb-4">
            <h4 class="h6 fw-bold mb-2">
              歌唱経験
            </h4>

            <p class="mb-0">
              <%= @user.singing_experience.presence || "未登録" %>
            </p>
          </div>

          <!-- ダンス経験 -->
          <div class="mb-4">
            <h4 class="h6 fw-bold mb-2">
              ダンス経験
            </h4>

            <p class="mb-0">
              <%= @user.dance_experience.presence || "未登録" %>
            </p>
          </div>

          <!-- 希望地域 -->
          <div class="mb-4">
            <h4 class="h6 fw-bold mb-2">
              希望地域
            </h4>

            <p class="mb-0">
              <%= @user.preferred_area.presence || "未登録" %>
            </p>
          </div>

          <hr class="mb-4">

          <!-- ボタン -->
          <div class="d-flex flex-wrap gap-2">

            <%= link_to "スカウトを送る",
                        new_theater_user_scout_path(@user),
                        class: "btn btn-primary px-4" %>

            <%= link_to "ユーザー一覧へ戻る",
                        theater_users_path,
                        class: "btn btn-outline-secondary px-4" %>

          </div>

        </div>
      </div>

    </div>
  </div>

</div>