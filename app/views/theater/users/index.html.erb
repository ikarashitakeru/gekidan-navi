<div class="container py-5">

  <h2 class="fw-bold mb-4">ユーザー検索</h2>

  <div class="card shadow-sm mb-4">
    <div class="card-body">

      <%= form_with url: theater_users_path,
                    method: :get,
                    local: true do |f| %>

        <div class="row g-3">

          <div class="col-md-5">
            <%= f.label :keyword,
                        "氏名",
                        class: "form-label" %>

            <%= f.text_field :keyword,
                             value: params[:keyword],
                             class: "form-control",
                             placeholder: "例：山田" %>
          </div>

          <div class="col-md-5">
            <%= f.label :area,
                        "希望地域",
                        class: "form-label" %>

            <%= f.text_field :area,
                             value: params[:area],
                             class: "form-control",
                             placeholder: "例：東京都" %>
          </div>

          <div class="col-md-2 d-flex align-items-end">
            <%= f.submit "検索",
                         class: "btn btn-primary w-100" %>
          </div>

        </div>

      <% end %>

    </div>
  </div>

  <% if @users.any? %>

    <% @users.each do |user| %>
      <div class="card shadow-sm mb-3">
        <div class="card-body">

          <h4 class="fw-bold">
            <%= user.name %>
          </h4>

          <p class="mb-2">
            希望地域：
            <%= user.preferred_area.presence || "未登録" %>
          </p>

          <p class="mb-2">
            演技経験：
            <%= user.acting_experience.presence || "未登録" %>
          </p>

          <%= link_to "プロフィールを見る",
                      theater_user_path(user),
                      class: "btn btn-outline-primary" %>

        </div>
      </div>
    <% end %>

  <% else %>

    <div class="alert alert-light border">
      条件に一致するユーザーが見つかりませんでした。
    </div>

  <% end %>

</div>