<div class="container py-4 py-md-5">

  <!-- ページ上部 -->
  <div class="d-flex flex-column flex-md-row
              justify-content-between
              align-items-md-center
              gap-3
              mb-4">

    <div>
      <h2 class="fw-bold mb-1">
        スカウト管理
      </h2>

      <p class="text-muted mb-0">
        ユーザーを探してスカウトを送信したり、
        送信済みのスカウトを確認できます。
      </p>
    </div>

    <div>
      <%= link_to "ユーザーを探してスカウトする",
                  theater_users_path,
                  class: "btn btn-primary" %>
    </div>

  </div>

  <!-- 送信済みスカウト -->
  <div class="mb-3">
    <h3 class="h5 fw-bold mb-1">
      送信済みスカウト
    </h3>

    <p class="text-muted small mb-0">
      これまで送信したスカウトと回答状況を確認できます。
    </p>
  </div>

  <% if @scouts.any? %>

    <div class="card shadow-sm border-0">
      <div class="card-body p-0">

        <div class="table-responsive">
          <table class="table align-middle mb-0">

            <thead class="table-light">
              <tr>
                <th class="px-4 py-3">
                  ユーザー
                </th>

                <th class="py-3">
                  案内した募集
                </th>

                <th class="py-3">
                  送信日
                </th>

                <th class="py-3">
                  状況
                </th>

                <th class="py-3 text-end pe-4">
                  操作
                </th>
              </tr>
            </thead>

            <tbody>

              <% @scouts.each do |scout| %>

                <tr>

                  <!-- ユーザー -->
                  <td class="px-4 py-3">
                    <strong>
                      <%= scout.user.name %>
                    </strong>
                  </td>

                  <!-- 募集 -->
                  <td>
                    <%= scout.recruitment.title %>
                  </td>

                  <!-- 送信日 -->
                  <td>
                    <%= scout.created_at.strftime("%Y年%m月%d日") %>
                  </td>

                  <!-- 状況 -->
                  <td>

                    <% if scout.sent? %>

                      <span class="badge text-bg-secondary">
                        送信済み
                      </span>

                    <% elsif scout.accepted? %>

                      <span class="badge text-bg-success">
                        承諾
                      </span>

                    <% elsif scout.declined? %>

                      <span class="badge text-bg-danger">
                        辞退
                      </span>

                    <% end %>

                  </td>

                  <!-- 操作 -->
                  <td class="text-end pe-4">

                    <%= link_to "詳細",
                                theater_scout_path(scout),
                                class: "btn btn-outline-primary btn-sm" %>

                  </td>

                </tr>

              <% end %>

            </tbody>

          </table>
        </div>

      </div>
    </div>

  <% else %>

    <!-- まだ送信していない場合 -->
    <div class="card shadow-sm border-0">

      <div class="card-body text-center py-5">

        <h3 class="h5 fw-bold mb-3">
          まだスカウトを送信していません
        </h3>

        <p class="text-muted mb-4">
          ユーザーのプロフィールを確認して、
          条件に合うユーザーへスカウトを送ってみましょう。
        </p>

        <%= link_to "ユーザーを探す",
                    theater_users_path,
                    class: "btn btn-primary" %>

      </div>

    </div>

  <% end %>

</div>