<div class="container py-5">
  <div class="row justify-content-center">
    <div class="col-12 col-md-8">

      <div class="card shadow-sm">
        <div class="card-body p-4">

          <h2 class="fw-bold mb-4">
            劇団情報編集
          </h2>

          <%= form_with model: @theater,
                        url: theater_theater_path,
                        method: :patch,
                        local: true do |f| %>

            <div class="mb-3">
              <%= f.label :name, "劇団名", class: "form-label" %>
              <%= f.text_field :name, class: "form-control" %>
            </div>

            <div class="mb-3">
              <%= f.label :introduction, "劇団紹介", class: "form-label" %>
              <%= f.text_area :introduction,
                              rows: 5,
                              class: "form-control",
                              placeholder: "劇団の特徴や活動内容を入力してください" %>
            </div>

            <div class="mb-3">
              <%= f.label :activity_area, "活動地域", class: "form-label" %>
              <%= f.text_field :activity_area,
                               class: "form-control",
                               placeholder: "例：東京都" %>
            </div>

            <div class="mb-4">
              <%= f.label :website_url, "ホームページURL", class: "form-label" %>
              <%= f.url_field :website_url,
                              class: "form-control",
                              placeholder: "https://example.com" %>
            </div>

            <div class="d-flex gap-3">
              <%= f.submit "変更を保存",
                           class: "btn btn-primary" %>

              <%= link_to "戻る",
                          theater_theater_path,
                          class: "btn btn-outline-secondary" %>
            </div>

          <% end %>

        </div>
      </div>
    </div>
  </div>
</div>