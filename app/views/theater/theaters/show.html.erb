<div class="container py-5">
  <div class="row justify-content-center">
    <div class="col-12 col-md-8">

      <div class="card shadow-sm">
        <div class="card-body p-4">

          <h2 class="fw-bold mb-4">
            劇団情報
          </h2>

          <div class="mb-3">
            <strong>劇団名</strong>
            <p class="mb-0"><%= @theater.name %></p>
          </div>

          <div class="mb-3">
            <strong>メールアドレス</strong>
            <p class="mb-0"><%= @theater.email %></p>
          </div>

          <div class="mb-3">
            <strong>劇団紹介</strong>
            <p class="mb-0">
              <%= @theater.introduction.presence || "未登録" %>
            </p>
          </div>

          <div class="mb-3">
            <strong>活動地域</strong>
            <p class="mb-0">
              <%= @theater.activity_area.presence || "未登録" %>
            </p>
          </div>

          <div class="mb-4">
            <strong>ホームページ</strong>
            <p class="mb-0">
              <%= @theater.website_url.presence || "未登録" %>
            </p>
          </div>

          <%= link_to "劇団情報を編集",
                      edit_theater_theater_path,
                      class: "btn btn-primary" %>

        </div>
      </div>

    </div>
  </div>
</div>